# systemd service unit for the TalkSig RF24 car server.
#
# Install with one of:
#   On the Pi directly:  make install
#   From your laptop:    make service
#
# Both commands substitute the placeholders below automatically.
# To install by hand, replace them yourself, e.g.:
#   sed -e 's|{{PI_DIR}}|/home/pi/talksig|g' \
#       -e 's|{{USER}}|pi|g' \
#       -e 's|{{UV_BIN}}|/home/pi/.local/bin/uv|g' \
#       talksig.service | sudo tee /etc/systemd/system/talksig.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now talksig

[Unit]
Description=TalkSig – Car RF24 Communication Server
After=network.target
Wants=network.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PI_DIR}}
ExecStart={{UV_BIN}} run python server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Give the SPI / GPIO devices a moment after boot
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
