# Required for /api/clean-stale-online (stale-online cleanup).
# Paste the full JSON from Firebase Console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# Optional. Defaults to talksig-wireless Realtime Database URL if unset.
# FIREBASE_DATABASE_URL=https://talksig-wireless-default-rtdb.asia-southeast1.firebasedatabase.app/

# Optional. If set, the cleanup API only accepts: Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=your-secret
